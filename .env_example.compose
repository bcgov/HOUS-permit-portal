# Optional local port overrides. Copy to .env.compose.
# compose.yml provides all defaults, including images and development credentials.
# Uncomment only the ports you need to change to avoid conflicts.
# Update the matching application settings in .env (see README.md).

# POSTGRES_HOST_PORT=15432
# REDIS_HOST_PORT=16379
# ELASTICSEARCH_HOST_PORT=19200
# SEAWEEDFS_HOST_PORT=19001
# SEAWEEDFS_ADMIN_HOST_PORT=19002
# ANYCABLE_HOST_PORT=8080

# If changing the host Ruby RPC port, also update its command in Procfile.dev.
# ANYCABLE_RPC_PORT=50051
