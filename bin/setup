#!/usr/bin/env ruby
require "fileutils"
require "open3"

APP_ROOT = File.expand_path("..", __dir__)

def run!(*args)
  system(*args, exception: true)
end

begin
  Dir.chdir(APP_ROOT) do
    abort "Missing .env. Run: cp .env_example .env" unless File.file?(".env")
    unless [nil, "development"].include?(ENV["RAILS_ENV"])
      abort "bin/setup is for local development only."
    end
    ruby_version = File.read(".ruby-version").strip
    unless RUBY_VERSION == ruby_version
      abort "Select Ruby #{ruby_version} with rbenv before running bin/setup (current: #{RUBY_VERSION})."
    end
    node_version = File.read(".nvmrc").strip
    node, status = Open3.capture2("node", "--version")
    unless status.success? && node.strip == node_version
      abort "Run nvm install && nvm use first (expected #{node_version})."
    end

    puts "== Installing locked dependencies =="
    bundler_version =
      File.read("Gemfile.lock").match(/BUNDLED WITH\s+([\d.]+)/)[1]
    unless Gem::Specification.find_all_by_name("bundler", bundler_version).any?
      run! "gem",
           "install",
           "bundler",
           "--version",
           bundler_version,
           "--no-document"
    end
    bundle = ["bundle", "_#{bundler_version}_"]
    system(*bundle, "check") || run!(*bundle, "install")
    run! "npm", "ci"

    unless File.exist?("config/database.yml")
      FileUtils.cp "config/database.yml.local", "config/database.yml"
    end

    # Use Rails' resolved configuration, including any DATABASE_URL override.
    run!({ "RAILS_ENV" => "development" }, *bundle, "exec", "rails", "runner", <<~RUBY)
      configs = ActiveRecord::Base.configurations
      development = configs.configs_for(env_name: "development", name: "primary")
      test = configs.configs_for(env_name: "test", name: "primary")
      unless development&.database && test&.database && development.database != test.database
        abort "Configure separate development and test databases; see config/database.yml.local."
      end
    RUBY

    puts "== Preparing development database and initial seeds =="
    # Rails seeds a fresh development database; prepare test separately below.
    run!(
      { "RAILS_ENV" => "development", "SKIP_TEST_DATABASE" => "true" },
      *bundle,
      "exec",
      "rails",
      "db:prepare"
    )
    puts "== Preparing isolated test database =="
    # Do not load development demo seeds into the test database.
    run!(
      { "RAILS_ENV" => "test" },
      *bundle,
      "exec",
      "rails",
      "db:create",
      "db:migrate"
    )

    puts "== Building PDF renderer =="
    run!({ "RAILS_ENV" => "development" }, "npm", "run", "build:ssr")
    puts "Setup complete. Start the application with bin/dev."
  end
rescue Errno::ENOENT => e
  abort "Missing prerequisite: #{e.message}. See README.md."
rescue StandardError => e
  abort "Setup failed: #{e.message}"
end
