# Host application only. Copy to .env. Values below are for local development only.
# Match infrastructure credentials/ports in .env.compose (see README.md).
# External *_stub URLs match CI/VCR recordings; replace them for live integrations.
APP_DOMAIN="localhost"

DEVISE_JWT_SECRET_KEY="local-development-only-jwt-secret-change-outside-local"
KEYCLOAK_SECRET=
KEYCLOAK_CLIENT=
KEYCLOAK_AUTH_URL=

FROM_EMAIL="no-reply@bc.gov.ca"
SESSION_TIMEOUT_MINUTES=360

CONSIGNO_URL=https://consignostub.dev-hous-permit-portal.com/stub/api/v1

BCGOV_OBJECT_STORAGE_ENDPOINT="http://127.0.0.1:19001"
BCGOV_OBJECT_STORAGE_BUCKET="hous-local"
BCGOV_OBJECT_STORAGE_ACCESS_KEY_ID="hous-local"
BCGOV_OBJECT_STORAGE_SECRET_ACCESS_KEY="hous-local-password"
BCGOV_OBJECT_STORAGE_REGION="us-east-1"

CHES_HOST=""
CHES_AUTH_HOST=""
CHES_CLIENT_ID=""
CHES_CLIENT_SECRET=""

GEO_ALR_REST_URL=https://alr_rest_url_stub/arcserver/rest/services/
GEO_LTSA_PARCELMAP_REST_URL=https://ltsa_parcel_map_url_stub/arcserver/rest/services
GEO_LTSA_PARCELMAP_GIS_REST_URL=https://ltsa_parcel_map_gis_url_stub/geo/pub
GEO_BC_ADMIN_BOUNDARIES_REST_URL=https://delivery.maps.gov.bc.ca/arcgis/rest/services/whse/bcgw_pub_whse_legal_admin_boundaries/MapServer


# Geocoder variables
BCGOV_ADDRESS_GEOCODER_API_KEY=""
BCGOV_ADDRESS_GEOCODER_CLIENT_ID=""
BCGOV_ADDRESS_GEOCODER_URL="https://address_geocoder_url_stub"

# Step Code
PART_9_MIN_ENERGY_STEP=3
PART_9_MAX_ENERGY_STEP=5
PART_9_MIN_ZERO_CARBON_STEP=1
PART_9_MAX_ZERO_CARBON_STEP=4

PART_3_MIN_ENERGY_STEP=2
PART_3_MAX_ENERGY_STEP=4
PART_3_MIN_ZERO_CARBON_STEP=1
PART_3_MAX_ZERO_CARBON_STEP=4

# ActiveRecord attribute encryption variables

# the minimum lengths for the keys should be 12 bytes for the
# primary key (this will be used to derive the AES 32
# bytes key) and 20 bytes for the salt.
# You can auto generate this in the console with: bin/rails db:encryption:init

ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY="local-only-primary-key-0123456789"
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY="local-only-deterministic-01234567"
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT="local-only-salt-012345678901234567"

# Dev Only, we disable compliance checks by default
RUN_COMPLIANCE_ON_SAVE=false


# Dev Only, we allow force publish to make testing easier
ENABLE_TEMPLATE_FORCE_PUBLISH="true"
VITE_ENABLE_TEMPLATE_FORCE_PUBLISH="true"

# Reactotron MST/API tracking (DEV only). Default on; set false if local tabs OOM.
# Restart Vite after changing.
VITE_REACTOTRON="false"

# Dev Only, enable email/password login (never honored when RAILS_ENV=production)
ENABLE_LOCAL_PASSWORD_AUTH="true"
VITE_ENABLE_LOCAL_PASSWORD_AUTH="true"

# Sidekiq
SIDEKIQ_DEV_REDIS_URL="redis://127.0.0.1:16379/0"
ANYCABLE_DEV_REDIS_URL="redis://127.0.0.1:16379/1"

# Rate Limiting
RATE_LIMIT_DEV_REDIS_URL="redis://127.0.0.1:16379/2"
RATE_LIMIT_REDIS_DB=2

# Rails Redis Cache
CACHE_DEV_REDIS_URL="redis://127.0.0.1:16379/4"
CACHE_REDIS_DB=4

# Host database (do not set DATABASE_URL to the development database for tests).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_USER=hous
POSTGRES_PASSWORD=hous-local-password
ELASTICSEARCH_URL=http://127.0.0.1:19200
SIMPLE_FEED_DEV_REDIS_URL=redis://127.0.0.1:16379/3
ANYCABLE_URL=ws://localhost:8080/cable
ANYCABLE_RPC_HOST=0.0.0.0:50051
SECURE_JWT_COOKIE=false
EXCEPTION_NOTIFIER_ENABLED=false
SIDEKIQ_CONCURRENCY=5

########################################################################
# Production Only (HA related or security settings) — reference only
# These are deployment examples, not local defaults. Keep them commented locally.
########################################################################

# Docker build related
# Leave IS_DOCKER_BUILD unset locally: even "false" activates build-only behavior.
# IS_DOCKER_BUILD=false

# Exception Notifier
# EXCEPTION_NOTIFIER_EMAIL_PREFIX=""
# EXCEPTION_NOTIFIER_RECIPIENTS=""
# EXCEPTION_NOTIFIER_ENABLED=true

# Redis HA settings
