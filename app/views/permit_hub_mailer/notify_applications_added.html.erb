<%
  project = @permit_project
  project_title = project&.title
  project_url = project && FrontendUrlHelper.frontend_url("/projects/#{project.id}")
  link_style = "color: #1a5a96; text-decoration: underline;"
%>
<!-- START MAIN CONTENT AREA -->
<tr>
  <td class="wrapper" style="font-family: 'Open Sans', sans-serif; font-size: 16px; vertical-align: top; box-sizing: border-box; padding: 56px 32px;" valign="top">
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" style="border-collapse: separate; mso-table-lspace: 0pt; mso-table-rspace: 0pt; min-width: 100%; width: 100%;" width="100%">
      <tr>
        <td style="font-family: 'Open Sans', sans-serif; font-size: 16px; vertical-align: top;" valign="top">
          <h1 style="color: #292929; font-family: 'Open Sans', sans-serif; font-weight: 700; line-height: 1.4; text-align: left; font-size: 28px; margin-top: 0; margin-bottom: 32px;">Permit applications were added to your project</h1>

          <p style="font-family: 'Open Sans', sans-serif; font-size: 16px; line-height: 26px; font-weight: normal; margin: 0; margin-bottom: 12px;">Hello <%= @user.first_name.presence || @user.name %>,</p>
          <p style="font-family: 'Open Sans', sans-serif; font-size: 16px; line-height: 26px; font-weight: normal; margin: 0; margin-bottom: 12px;">
            <%= @jurisdiction_name %> added the following permit applications to your project:
          </p>
          <% if project_title.present? %>
            <p style="font-family: 'Open Sans', sans-serif; font-size: 16px; line-height: 26px; font-weight: normal; margin: 0; margin-bottom: 12px;">
              <strong>Project:</strong> <a href="<%= project_url %>" style="<%= link_style %>"><%= project_title %></a>
            </p>
          <% end %>
          <ul style="font-family: 'Open Sans', sans-serif; font-size: 16px; line-height: 26px; font-weight: normal; margin: 0 0 16px; padding-left: 24px;">
            <% @applications.each do |application| %>
              <li style="margin-left: 5px;">
                <a href="<%= application.submitter_frontend_url %>" style="<%= link_style %>"><%= application.number %></a><% if application.nickname.present? %> (<%= application.nickname %>)<% end %>
              </li>
            <% end %>
          </ul>

          <% if @note.present? %>
            <h2 style="color: #292929; font-family: 'Open Sans', sans-serif; font-weight: 700; line-height: 1.4; margin-top: 16px; margin-bottom: 12px; text-align: left; font-size: 22px;">Message from the reviewer</h2>
            <p style="font-family: 'Open Sans', sans-serif; font-size: 16px; line-height: 26px; font-weight: normal; margin: 0 0 16px;"><%= @note %></p>
          <% end %>

          <table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin: 8px 0 16px;">
            <tr>
              <td style="background: #003366; border-radius: 4px;">
                <a href="<%= project_url %>" style="display: inline-block; padding: 8px 12px; font-family: 'Open Sans', sans-serif; font-size: 16px; color: #ffffff; text-decoration: none;">View your project</a>
              </td>
            </tr>
          </table>

          <p style="font-family: 'Open Sans', sans-serif; font-size: 16px; line-height: 26px; font-weight: normal; margin: 0;">
            The Building Permit Hub Team
          </p>
        </td>
      </tr>
    </table>
  </td>
</tr>
<!-- END MAIN CONTENT AREA -->
