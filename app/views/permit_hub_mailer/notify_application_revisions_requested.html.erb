<%
  requests = @permit_application.revision_requests
  field_revisions = requests.select { |request| request.is_a?(FieldRevisionRequest) }
  supporting_information = requests.select { |request| request.is_a?(SupportingDocumentRevisionRequest) }
  reviewer_message = Note.plain_body(@permit_application.latest_submission_version&.applicant_note)
  project = @permit_application.permit_project
  project_title = project&.title
  project_url = project && FrontendUrlHelper.frontend_url("/projects/#{project.id}/overview")
  template_name = @permit_application.template_nickname
  link_style = "color: #1a5a96; text-decoration: underline;"
%>
<!-- START MAIN CONTENT AREA -->
<tr>
  <td class="wrapper" style="font-family: 'Open Sans', sans-serif; font-size: 16px; vertical-align: top; box-sizing: border-box; padding: 56px 32px;" valign="top">
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" style="border-collapse: separate; mso-table-lspace: 0pt; mso-table-rspace: 0pt; min-width: 100%; width: 100%;" width="100%">
      <tr>
        <td style="font-family: 'Open Sans', sans-serif; font-size: 16px; vertical-align: top;" valign="top">
          <h1 style="color: #292929; font-family: 'Open Sans', sans-serif; font-weight: 700; line-height: 1.4; text-align: left; font-size: 28px; margin-top: 0; margin-bottom: 32px;">Changes requested for your permit application</h1>

          <p style="font-family: 'Open Sans', sans-serif; font-size: 16px; line-height: 26px; font-weight: normal; margin: 0; margin-bottom: 12px;">Hello <%= @user.first_name.presence || @user.name %>,</p>
          <p style="font-family: 'Open Sans', sans-serif; font-size: 16px; line-height: 26px; font-weight: normal; margin: 0; margin-bottom: 12px;">
            <%= @permit_application.jurisdiction.qualified_name %> has requested changes or additional information for your permit application:
          </p>
          <p style="font-family: 'Open Sans', sans-serif; font-size: 16px; line-height: 26px; font-weight: normal; margin: 0; margin-bottom: 16px;">
            <% if project_title.present? %>
              <strong>Project:</strong> <a href="<%= project_url %>" style="<%= link_style %>"><%= project_title %></a><br>
            <% end %>
            <% if template_name.present? %>
              <strong>Template:</strong> <%= template_name %><br>
            <% end %>
            <% if @permit_application.nickname.present? %>
              <strong>Permit application:</strong> <%= @permit_application.nickname %><br>
            <% end %>
            <strong>HUB#:</strong> <a href="<%= @permit_application.submitter_frontend_url %>" style="<%= link_style %>"><%= @permit_application.number %></a>
          </p>

          <hr style="border: 0; border-top: 1px solid #d9d9d9; margin: 16px 0;">

          <h2 style="color: #292929; font-family: 'Open Sans', sans-serif; font-weight: 700; line-height: 1.4; margin-top: 16px; margin-bottom: 12px; text-align: left; font-size: 22px;">Requests</h2>

          <% if field_revisions.any? %>
            <p style="font-family: 'Open Sans', sans-serif; font-size: 16px; line-height: 26px; font-weight: normal; margin: 0;">Revisions:</p>
            <ul style="font-family: 'Open Sans', sans-serif; font-size: 16px; line-height: 26px; font-weight: normal; margin: 0 0 12px; padding-left: 24px;">
              <% field_revisions.each do |request| %>
                <li style="margin-left: 5px;"><%= request.requirement_json&.dig("label").presence || "Revision request" %></li>
              <% end %>
            </ul>
          <% end %>

          <% if supporting_information.any? %>
            <p style="font-family: 'Open Sans', sans-serif; font-size: 16px; line-height: 26px; font-weight: normal; margin: 0;">Supporting information:</p>
            <ul style="font-family: 'Open Sans', sans-serif; font-size: 16px; line-height: 26px; font-weight: normal; margin: 0 0 12px; padding-left: 24px;">
              <% supporting_information.each do |request| %>
                <li style="margin-left: 5px;"><%= request.title.presence || "Supporting information" %></li>
              <% end %>
            </ul>
          <% end %>

          <% if reviewer_message.present? %>
            <h2 style="color: #292929; font-family: 'Open Sans', sans-serif; font-weight: 700; line-height: 1.4; margin-top: 16px; margin-bottom: 12px; text-align: left; font-size: 22px;">Message from the reviewer</h2>
            <p style="font-family: 'Open Sans', sans-serif; font-size: 16px; line-height: 26px; font-weight: normal; margin: 0 0 16px;"><%= reviewer_message %></p>
          <% end %>

          <hr style="border: 0; border-top: 1px solid #d9d9d9; margin: 16px 0;">

          <h2 style="color: #292929; font-family: 'Open Sans', sans-serif; font-weight: 700; line-height: 1.4; margin-top: 16px; margin-bottom: 12px; text-align: left; font-size: 22px;">Next steps</h2>
          <ul style="font-family: 'Open Sans', sans-serif; font-size: 16px; line-height: 26px; font-weight: normal; margin: 0 0 16px; padding-left: 24px;">
            <li style="margin-left: 5px;">Log in to Building Permit Hub to review each request, update your application, and provide any supporting information as requested.</li>
          </ul>

          <table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin: 8px 0 16px;">
            <tr>
              <td style="background: #003366; border-radius: 4px;">
                <a href="<%= @permit_application.submitter_frontend_url %>" style="display: inline-block; padding: 8px 12px; font-family: 'Open Sans', sans-serif; font-size: 16px; color: #ffffff; text-decoration: none;">Log in to Building Permit Hub</a>
              </td>
            </tr>
          </table>

          <hr style="border: 0; border-top: 1px solid #d9d9d9; margin: 16px 0;">

          <p style="font-family: 'Open Sans', sans-serif; font-size: 16px; line-height: 26px; font-weight: normal; margin: 0 0 12px;">
            If you have any questions or need technical assistance, reach out to us at <a href="mailto:digital.codes.permits@gov.bc.ca" style="color: #1a5a96; text-decoration: underline;">digital.codes.permits@gov.bc.ca</a>
          </p>
          <p style="font-family: 'Open Sans', sans-serif; font-size: 16px; line-height: 26px; font-weight: normal; margin: 0 0 24px;">
            For questions about your permit application, reach out to your local building authority.
          </p>
          <p style="font-family: 'Open Sans', sans-serif; font-size: 16px; line-height: 26px; font-weight: normal; margin: 0;">
            The Building Permit Hub Team
          </p>
        </td>
      </tr>
    </table>
  </td>
</tr>
<!-- END MAIN CONTENT AREA -->
